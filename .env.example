# ---------------------------------------------------------------------------
# BD Screens — environment template
# Copy to `.env` and fill in. `.env` is git-ignored; never commit real values.
# ---------------------------------------------------------------------------

# --- Server -----------------------------------------------------------------
PORT=8787
NODE_ENV=development
LOG_LEVEL=debug

# Only matters in production behind a proxy (Render, Railway, Nginx, Fly).
TRUST_PROXY=0

# Comma-separated allow-list used by CORS in development and by logs in prod.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Catalogue provider (server-side only) ----------------------------------
# Get a free v4 read token: https://www.themoviedb.org/settings/api
# This is read by the Express server. It is NOT exposed to the browser bundle.
# Without it the app runs on the bundled BD Screens Originals catalogue.
TMDB_API_TOKEN=

# --- Firebase (client-side, public by design) -------------------------------
# Firebase web config is public: it identifies the project, it does not
# authorise anything. This app uses Firebase Auth only — no database, no
# storage bucket contents. See docs/SECURITY.md for the provider settings that
# do matter.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
